{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Project",
            "type": "shell",
            "command": "g++ -std=c++17 -g $(find ${workspaceFolder}/src -name '*.cpp') -I${workspaceFolder}/src -o ${workspaceFolder}/bin/program",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "windows": {
                "options": {
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-Command"]
                    }
                },
                "command": "g++ -std=c++17 -g (Get-ChildItem -Recurse '${workspaceFolder}/src/*.cpp' | Select-Object -ExpandProperty FullName) -I${workspaceFolder}/src -o ${workspaceFolder}/bin/program.exe"
            }
        }
    ]
}
